CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_DSI_PANEL_K7SR_38_0C_0A_VIDEO=y
CONFIG_DRM_DSI_PANEL_K7SR_38_0C_0B_VIDEO=y

# From entry_level
