# CONFIG_MTK_TINYSYS_VCP_SUPPORT is not set
# CONFIG_MTK_MML is not set
CONFIG_MTK_QOS_LEGACY_V1=y
CONFIG_MTK_MML_LEGACY=m
# CONFIG_COMMON_CLK_MTK_FREQ_HOPPING_GPUEB is not set
CONFIG_SND_SOC_MT6358_ACCDET=m
CONFIG_MTK_CM_MGR_LEGACY_V1=m
CONFIG_MTK_CM_MGR_MT6781=m
CONFIG_MTK_EMI_LEGACY=m
CONFIG_MTK_COMBO_CHIP_CONSYS_6781=y
# CONFIG_MTK_CONN_LTE_IDC_SUPPORT is not set
# CONFIG_DEVICE_MODULES_SPMI_MTK_PMIF is not set
# CONFIG_MTK_MBRAINK_MT6991 is not set
# CONFIG_MTK_MBRAINK_MT6989 is not set
# CONFIG_MTK_MBRAINK_MT6993 is not set
# CONFIG_MTK_MBRAINK_MT6899 is not set
# CONFIG_MTK_MBRAINK_BRIDGE is not set
# CONFIG_MTK_MBRAINK is not set
# CONFIG_MTK_MBRAINK_PERF is not set
# CONFIG_MTK_C2PS is not set
# CONFIG_ARM_FFA_TRANSPORT is not set
# CONFIG_MTK_PERF_IOCTL_MAGT is not set
# CONFIG_MTK_GEARLESS_SUPPORT is not set
# CONFIG_MTK_CPUQOS_EXT is not set
# CONFIG_MTK_LEAKAGE_HIT is not set
# CONFIG_MTK_SCHED_FAST_LOAD_TRACKING is not set
